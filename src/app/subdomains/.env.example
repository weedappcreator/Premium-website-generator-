# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Never expose publicly

# ── Cloudflare ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=              # From Cloudflare → My Profile → API Tokens
CLOUDFLARE_ZONE_ID=                # From Cloudflare → your domain → Zone ID
ROOT_DOMAIN=weedkerwing.dev        # The domain you bought

# ── Make.com ───────────────────────────────────────────────
MAKE_WEBHOOK_URL=                  # Webhook URL from your Make scenario

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Resend (email) ─────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Admin ──────────────────────────────────────────────────
ADMIN_SECRET=choose_a_strong_secret_here
NEXT_PUBLIC_ADMIN_SECRET=same_secret_here
